{{- /* Page list for the Discord editor: title and file path of every page. */ -}}
{{- $pages := slice }}
{{- range $p := site.Pages }}
  {{- with $p.File }}
    {{- $pages = $pages | append (dict "title" $p.Title "path" (replace .Path "\\" "/") "url" $p.RelPermalink "special" (in (slice "all-pages" "recent-changes" "search") $p.Layout)) }}
  {{- end }}
{{- end }}
{{- jsonify $pages }}
